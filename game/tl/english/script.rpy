# game/script.rpy:475
translate english branch_end_god_85a824b5:

    # anaxa "呵，还是走到了这里啊。"
    anaxa "Heh, so you've come this far after all."

# game/script.rpy:481
translate english branch_end_god_4975f049:

    # phainon "……那刻夏老师？"
    phainon "...Professor Anaxa?"

# game/script.rpy:483
