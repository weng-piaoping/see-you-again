translate english prologue_f0140b90:

    # narrator "就能开启再创世，拯救因黑潮死去的人们。"
    narrator "Then he could carry on his duty of Worldbearing, and bring back those who had perished in the blacktide in Era Nova. "

# game/script.rpy:314
